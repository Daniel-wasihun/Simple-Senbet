# ==============================================================================
# Simple Senbet Frontend (Next.js BFF) — Production Environment Template
# ==============================================================================
# Copy this file to .env.production on your frontend production host.
# ==============================================================================

NODE_ENV=production

# Public URL of the Laravel API (used by client-side browser links if needed)
NEXT_PUBLIC_API_URL=https://api.senbet.example.com

# Internal or direct URL used by Next.js Backend-For-Frontend (BFF) proxy routes.
# In Docker Compose, Nginx serves the HTTP API listener on port 8000:
BACKEND_API_URL=http://nginx:8000

# Canonical Frontend Application URL
FRONTEND_URL=https://senbet.example.com
APP_URL=https://senbet.example.com
NEXT_PUBLIC_APP_URL=https://senbet.example.com
