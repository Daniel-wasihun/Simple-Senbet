# ==============================================================================
# Simple Senbet — Production PHP-FPM 8.4 Container
# Self-contained, immutable multi-stage build without host source mounts
# ==============================================================================

# Stage 1: Extension provider stage
# Can be supplied via build-arg or built from root Dockerfile (`docker build -t simple-senbet-php84:latest .`)
ARG EXTENSION_IMAGE=simple-senbet-php84:latest
FROM ${EXTENSION_IMAGE} AS extensions

# Stage 2: Production PHP-FPM 8.4 runtime runner
FROM php:8.4-fpm-alpine AS runner

# Install only the runtime shared libraries needed by the pre-compiled extensions
RUN apk add --no-cache \
    libpng \
    libavif \
    libwebp \
    libjpeg-turbo \
    libxpm \
    freetype \
    icu-libs \
    libstdc++ \
    libpq \
    libzip

# Copy the pre-compiled PHP 8.4 extensions and ini configs
COPY --from=extensions /usr/local/lib/php/extensions/no-debug-non-zts-20240924/ /usr/local/lib/php/extensions/no-debug-non-zts-20240924/
COPY --from=extensions /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

# Recommended production PHP and OPcache configuration
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=10000'; \
    echo 'opcache.revalidate_freq=0'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.save_comments=1'; \
} > /usr/local/etc/php/conf.d/opcache-recommended.ini

# Install official Composer 2 binary
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html

# Copy Composer manifests first for layer caching
COPY composer.json composer.lock ./

# Install production dependencies without dev tools or scripts
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

# Copy full application source code into the production image
COPY . /var/www/html

# Generate optimized production autoloader
RUN composer dump-autoload --optimize --no-dev --no-interaction

# Establish writable Laravel directories and assign ownership to www-data
RUN mkdir -p \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

EXPOSE 9000

CMD ["php-fpm"]
