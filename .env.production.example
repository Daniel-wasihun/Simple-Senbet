# ==============================================================================
# Simple Senbet (የሰንበት ትምህርት ቤት) — Production Environment Template
# ==============================================================================
# CAUTION: Never commit actual production secrets, passwords, or keys to version control.
# Copy this file to .env on your production host and populate with secure, rotated secrets.
# ==============================================================================

# Application Identity & Lifecycle
APP_NAME="Simple Senbet (የሰንበት ትምህርት ቤት)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.senbet.example.com
FRONTEND_URL=https://senbet.example.com

# Regional & Localization
APP_LOCALE=am
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Cryptographic & Maintenance Settings
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# Operational Logging
# Stack channel with daily rotation to avoid unmanaged disk consumption.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Production Database (PostgreSQL 16+)
# Use a dedicated, least-privilege database user. Never use superuser/postgres.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=simple_senbet_production
DB_USERNAME=senbet_app
DB_PASSWORD=
DB_SSLMODE=prefer

# HTTP Session & Cookie Hardening
# Enforce HTTPS-only secure cookies and strict SameSite policy.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Production Cache & Distributed Locks
# Use PostgreSQL database store or Redis in high-throughput deployments.
CACHE_STORE=database
CACHE_PREFIX=senbet_cache_

# Asynchronous Background Queues
QUEUE_CONNECTION=database

# File Storage
FILESYSTEM_DISK=local

# Redis (Optional — Recommended for High-Traffic Deployments)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# CORS Restrictions
# Comma-separated list of allowed browser origins for direct API access.
CORS_ALLOWED_ORIGINS=https://senbet.example.com

# Production Mail Service
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@senbet.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Rate Limiting
RATE_LIMIT_API=60
